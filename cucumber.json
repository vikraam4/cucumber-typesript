{
    "default": {
        "path": [
            "features/*.feature"
        ],
        "require": [
            "features/step-definitions/*.ts",
            "features/hooks/*.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "format": [
            "progress",
            "json:reports/cucumber-report.json"
        ]
    }
}